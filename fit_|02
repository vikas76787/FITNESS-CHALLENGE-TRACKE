function startPart(part){const lv=LV(),used=new Set(),out=[];(part==="Full"?["Lower","Upper","Core","Cardio","Lower","Upper"]:Array(5).fill(part)).forEach(p=>{const e=EX.find(x=>x.p===p&&x.l<=lv&&!used.has(x.n));if(e){used.add(e.n);out.push(e.n)}});openPlayer(buildSession(out,PART[part]+" workout",null,12))}
