 $("plPhase").textContent={ready:"READY",prep:"GET READY",work:"WORK",rest:"REST · NEXT UP"}[P.ph];
 $("plName").textContent=e.n;$("plReps").textContent=(e.sec?"":e.r+" · ")+v.sec+" seconds";
