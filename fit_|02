function ring(reset){const f=$("ringFg");if(reset){f.style.transition="none";f.style.strokeDashoffset=0;f.getBoundingClientRect();f.style.transition=""}f.style.strokeDashoffset=CIRC*(1-P.t/P.tot)}
function drawP(){
 const st=P.s.steps;
 if(P.ph==="done"){const m=Math.max(1,Math.round(P.el/60));$("plPhase").textContent="DONE";$("plName").textContent="Workout complete 🎉";$("plReps").textContent=m+" min trained · "+st.length+" exercises";$("plTime").textContent="✓";$("plBar").style.width="100%";$("plInfo").innerHTML="";$("goBtn").textContent="Close";return}
 const v=P.ph==="rest"?st[P.i+1]:st[P.i],e=v.e,nx=st[P.i+(P.ph==="rest"?2:1)];
 $("plHead").textContent=P.s.label;$("plCount").textContent="Exercise "+(P.i+(P.ph==="rest"?2:1))+" of "+st.length+" · Round "+v.r+"/"+P.s.rounds;
