async function doAuth(){
 const email=$("authEmail").value.trim().toLowerCase(),pw=$("authPw").value,nm=$("authName").value.trim(),err=t=>{$("authErr").textContent=t};
 if(!/^\S+@\S+\.\S+$/.test(email))return err("Enter a valid email.");
 if(pw.length<6)return err("Password must be at least 6 characters.");
 const A=accts(),h=await hash(pw);
 if(authMode==="signup"){
  if(A[email])return err("Account already exists. Please log in.");
  if(!nm)return err("Please enter your name.");
  const old=!Object.keys(A).length&&localStorage.getItem("riseTrain_v2");
  A[email]={h};localStorage.setItem(ACC,JSON.stringify(A));
  if(old)localStorage.setItem("riseTrain_u_"+email,old);
  loadUser(email);state.name=nm;save();
 }else{
  if(!A[email]||A[email].h!==h)return err("Wrong email or password.");
  loadUser(email);
 }
 localStorage.setItem(SES,email);$("authPw").value="";enter();
 speak(authMode==="signup"?"Welcome, "+first()+"! Let's build a stronger you.":"Welcome back, "+first()+"! Ready to train?");
}
