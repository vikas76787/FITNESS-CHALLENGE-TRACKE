/* ===== Sessions ===== */
function buildSession(names,label,day,target){
 const list=names.map(findEx).filter(Boolean),lv=LV(),work=[30,40,50][lv],rest=[20,15,10][lv];
 const rs=e=>e.p==="Mobility"?5:rest,per=list.reduce((a,e)=>a+(e.sec||work)+rs(e),0);
 const rounds=Math.max(1,Math.min(4,Math.round(target*60/per))),steps=[];
 for(let r=1;r<=rounds;r++)list.forEach(e=>steps.push({e,r,sec:e.sec||work,rest:rs(e)}));
 const tot=steps.reduce((a,s)=>a+s.sec+s.rest,0)-(steps.length?steps[steps.length-1].rest:0);
 return{label,day,steps,list,rounds,work,rest,min:Math.round(tot/60)}}
