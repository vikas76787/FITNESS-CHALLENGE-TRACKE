function score(v){let s=0;if(/natural|neural|online|premium|enhanced/i.test(v.name))s+=4;if(/google/i.test(v.name))s+=2;if(/en-IN/i.test(v.lang))s+=2;else if(/en-(GB|US)/i.test(v.lang))s+=1;if(/female|samantha|aria|jenny|zira|heera|neerja|karen/i.test(v.name))s+=1;return s}
function bestVoice(){if(!VOICES.length)VOICES=getV();const sv=state&&state.voice&&VOICES.find(v=>v.name===state.voice);return sv||[...VOICES].sort((a,b)=>score(b)-score(a))[0]}
