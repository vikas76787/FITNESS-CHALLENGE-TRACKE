function toggleRun(){
 if(P.ph==="done")return stopSession(true);
 if(P.ph==="ready"){try{navigator.wakeLock&&navigator.wakeLock.request("screen").then(l=>lock=l)}catch(e){}P.run=true;say("Let's go, "+first()+"! Get ready for "+P.s.steps[0].e.n+".");startPhase("prep",5);P.iv=setInterval(tick,1000);return}
 P.run=!P.run;if(P.run)say("Resuming.");else cancelSpeech();drawP()
}
function tick(){
 if(!P.run)return;P.el++;P.t--;
 if(P.t>0){
  if(P.t<=3)say(String(P.t));
  else if(P.ph==="work"&&P.tot>=30&&P.t===Math.floor(P.tot/2))say("Halfway there. Keep going!");
  else if(P.ph==="work"&&P.tot>=30&&P.t===10)say("Ten seconds left. Finish strong!");
  $("plTime").textContent=P.t;ring();return}
 const st=P.s.steps,v=st[P.i];
 if(P.ph==="prep"){startPhase("work",v.sec);say("Go!")}
 else if(P.ph==="work"){
  if(P.i>=st.length-1)return finish();
  if(v.rest>0){const n=st[P.i+1].e;startPhase("rest",v.rest);say("Rest. Next up: "+n.n+(n.sec?"":", "+n.r)+".")}
  else{P.i++;startPhase("work",st[P.i].sec);say("Go!")}}
 else{P.i++;startPhase("work",st[P.i].sec);say("Go!")}
}
function skip(d){if(["ready","done"].includes(P.ph))return;const n=P.ph==="rest"&&d>0?P.i+1:P.i+d;if(n<0)return;if(n>=P.s.steps.length)return finish();P.i=n;startPhase("work",P.s.steps[n].sec);say(P.s.steps[n].e.n+". Go!")}
function finish(){
 clearInterval(P.iv);P.run=false;P.ph="done";const m=Math.max(1,Math.round(P.el/60));
 say("Workout complete. Amazing work, "+first()+"!");drawP();beep(1500);
 if(P.s.day&&P.s.day===state.completed.length+1)completeToday(m);else{state.minutes=(state.minutes||0)+m;save();render()}
}
function stopSession(force){
 if(P&&!force&&P.ph!=="done"&&P.ph!=="ready"&&!confirm("Stop this workout?"))return;
 if(P)clearInterval(P.iv);P=null;cancelSpeech();try{lock&&lock.release()}catch(e){}lock=null;$("player").classList.remove("show")}
boot();
</script>
</body></html>
