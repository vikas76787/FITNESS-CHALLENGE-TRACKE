const defState=()=>({name:"Your Name",level:"beginner",completed:[],logs:{},unlocked:[],minutes:0,photo:"",startDate:new Date().toISOString(),bestStreak:0,body:{},focus:"Full",coach:true,rate:.95,voice:""});
const accts=()=>{try{return JSON.parse(localStorage.getItem(ACC)||"{}")}catch(e){return{}}};
async function hash(s){try{const b=await crypto.subtle.digest("SHA-256",new TextEncoder().encode("rt:"+s));return[...new Uint8Array(b)].map(x=>x.toString(16).padStart(2,"0")).join("")}catch(e){let h=5381;for(const c of "rt:"+s)h=(h*33^c.charCodeAt(0))>>>0;return"f"+h}}
function loadUser(email){user=email;state=defState();try{state={...state,...JSON.parse(localStorage.getItem("riseTrain_u_"+email)||"{}")}}catch(e){}}
function authTab(m){authMode=m;$("nameRow").style.display=m==="signup"?"":"none";$("tabLogin").classList.toggle("active",m==="login");$("tabSignup").classList.toggle("active",m==="signup");$("authGo").textContent=m==="signup"?"Create account":"Log in";$("authErr").textContent=""}
