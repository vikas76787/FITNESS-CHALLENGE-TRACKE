<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="theme-color" content="#04100a">
<title>Rise & Train — 30 Day Challenge</title>
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin><link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Sora:wght@500;600;700;800&display=swap" rel="stylesheet">
<style>
:root{--bg:#04100a;--green:#69e39a;--lime:#b8f27b;--cream:#f3f7ef;--muted:#a9bdb0;--gold:#ffd477;--red:#ff8a80;--line:rgba(255,255,255,.15);--glass:rgba(255,255,255,.07);--glass2:rgba(255,255,255,.12);--blur:blur(22px) saturate(170%);--shadow:0 24px 60px -22px rgba(0,0,0,.65),inset 0 1px 0 rgba(255,255,255,.2);--head:"Sora","Inter",ui-sans-serif,system-ui,sans-serif}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{margin:0;min-height:100vh;background:var(--bg);color:var(--cream);font:400 15px/1.6 "Inter",ui-sans-serif,system-ui,-apple-system,"Segoe UI",sans-serif;-webkit-font-smoothing:antialiased;overflow-x:hidden}
button,input,select{font:inherit}button{cursor:pointer}a{color:inherit;text-decoration:none}
option{background:#0c1f15;color:#f3f7ef}
::selection{background:var(--green);color:#06210f}
::-webkit-scrollbar{width:10px}::-webkit-scrollbar-thumb{background:rgba(255,255,255,.18);border-radius:10px}::-webkit-scrollbar-track{background:transparent}

/* ===== Background scene ===== */
.scene{position:fixed;inset:0;z-index:-3;background:linear-gradient(180deg,#030b07,#06140d 60%,#0a2318)}
.scene::before{content:"";position:absolute;inset:0;background:var(--art-bg) center bottom/cover no-repeat;opacity:.75}
.scene::after{content:"";position:absolute;inset:0;background:radial-gradient(ellipse at 50% 0,transparent 0,rgba(3,11,7,.6) 100%)}
.orb{position:fixed;z-index:-2;border-radius:50%;filter:blur(90px);pointer-events:none;animation:drift 22s ease-in-out infinite alternate}
.o1{width:520px;height:520px;left:-140px;top:-120px;background:rgba(105,227,154,.32)}
.o2{width:420px;height:420px;right:-120px;top:32%;background:rgba(255,212,119,.17);animation-delay:-8s}
.o3{width:480px;height:480px;left:28%;bottom:-220px;background:rgba(184,242,123,.2);animation-delay:-14s}
@keyframes drift{to{transform:translate3d(70px,45px,0) scale(1.18)}}

/* ===== Header ===== */
h1,h2,h3,h4,.heading,.brand,.timer,.stat strong{font-family:var(--head)}
.top{position:sticky;top:12px;z-index:10;width:min(1160px,94vw);margin:12px auto 0;padding:10px 12px 10px 16px;border-radius:22px;background:rgba(8,24,16,.5);-webkit-backdrop-filter:var(--blur);backdrop-filter:var(--blur);border:1px solid var(--line);box-shadow:var(--shadow);display:flex;align-items:center;justify-content:space-between;gap:14px}
.brand{display:flex;align-items:center;gap:11px;font-weight:800;letter-spacing:.14em;font-size:14px}
.brandmark{width:40px;height:40px;border-radius:14px;background:linear-gradient(145deg,var(--lime),var(--green));color:#06210f;display:grid;place-items:center;font-size:20px;box-shadow:0 8px 24px -6px rgba(105,227,154,.7),inset 0 1px 0 rgba(255,255,255,.6)}
.nav{display:flex;gap:4px;flex-wrap:wrap;padding:4px;border-radius:16px;background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.08)}
.nav button{border:0;background:transparent;color:var(--muted);padding:9px 16px;border-radius:12px;font-weight:600;font-size:14px;transition:.25s}
.nav button:hover{color:var(--cream);background:rgba(255,255,255,.08)}
.nav button.active{background:linear-gradient(135deg,var(--lime),var(--green));color:#06210f;font-weight:700;box-shadow:0 6px 20px -6px rgba(105,227,154,.8)}
.ghost{border:1px solid var(--line);background:var(--glass);-webkit-backdrop-filter:blur(12px);backdrop-filter:blur(12px);color:var(--cream);padding:10px 16px;border-radius:14px;font-weight:600;transition:.25s}
.ghost:hover{border-color:rgba(105,227,154,.7);background:var(--glass2);transform:translateY(-1px)}
.btn{border:0;border-radius:14px;padding:12px 20px;font-weight:700;background:linear-gradient(135deg,var(--lime),var(--green));color:#06210f;box-shadow:0 10px 26px -10px rgba(105,227,154,.9),inset 0 1px 0 rgba(255,255,255,.55);transition:.25s}
.btn:hover{filter:brightness(1.07);transform:translateY(-2px);box-shadow:0 16px 30px -10px rgba(105,227,154,.95),inset 0 1px 0 rgba(255,255,255,.55)}
.btn:disabled{opacity:.5;cursor:not-allowed;transform:none}

/* ===== Layout ===== */
.wrap{width:min(1160px,92vw);margin:26px auto 70px}
.page{display:none}.page.active{display:block;animation:rise .55s cubic-bezier(.2,.8,.2,1)}
@keyframes rise{from{opacity:0;transform:translateY(14px)}to{opacity:1;transform:none}}
.eyebrow{color:var(--green);font-size:12px;letter-spacing:.24em;font-weight:800;text-transform:uppercase}
.heading{font-size:clamp(34px,5.2vw,62px);line-height:1.02;letter-spacing:-.04em;margin:10px 0 14px;font-weight:700}
.heading span{background:linear-gradient(100deg,var(--lime),var(--green));-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent}
#milestones .heading span{background-image:linear-gradient(100deg,#fff1c2,var(--gold),#e9a93b)}
.sub{color:#cfe0d4;max-width:600px;font-size:16px}
.muted{color:var(--muted)}.small{font-size:12px}

/* ===== Hero banners ===== */
.hero{position:relative;overflow:hidden;border-radius:32px;min-height:250px;padding:40px 44px;display:flex;align-items:flex-end;border:1px solid var(--line);box-shadow:var(--shadow);background:linear-gradient(90deg,rgba(4,16,10,.9) 0%,rgba(4,16,10,.55) 52%,rgba(4,16,10,.05) 100%),var(--art) center 76%/cover}
.hero::after{content:"";position:absolute;inset:0;border-radius:inherit;background:linear-gradient(180deg,rgba(255,255,255,.1),transparent 35%);pointer-events:none}
.hero-lg{min-height:430px}
.herotxt{position:relative;z-index:1;max-width:620px}
.herobtns{display:flex;gap:12px;flex-wrap:wrap;margin-top:22px}
.herobtns .btn{padding:14px 24px}
.hero .heading{margin-top:6px}

/* ===== Glass panels ===== */
.panel{position:relative;background:var(--glass);-webkit-backdrop-filter:var(--blur);backdrop-filter:var(--blur);border:1px solid var(--line);border-radius:28px;padding:26px;box-shadow:var(--shadow)}
.panel::before{content:"";position:absolute;inset:0;border-radius:inherit;padding:1px;background:linear-gradient(145deg,rgba(255,255,255,.45),transparent 40%,transparent 70%,rgba(105,227,154,.3));-webkit-mask:linear-gradient(#000 0 0) content-box,linear-gradient(#000 0 0);-webkit-mask-composite:xor;mask-composite:exclude;pointer-events:none}
.panel .panel{background:rgba(255,255,255,.05);box-shadow:none}
.grid{display:grid;gap:16px}.g2{grid-template-columns:repeat(2,minmax(0,1fr))}.g3{grid-template-columns:repeat(3,minmax(0,1fr))}
.stats{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:14px;margin:22px 0}
.stat{padding:18px 20px;border-radius:22px;background:var(--glass);-webkit-backdrop-filter:var(--blur);backdrop-filter:var(--blur);border:1px solid var(--line);box-shadow:var(--shadow);transition:.3s}
.stat:hover{transform:translateY(-4px);border-color:rgba(105,227,154,.5)}
.stat strong{display:block;font-size:32px;line-height:1.2;font-weight:700;background:linear-gradient(120deg,#fff,var(--lime));-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent}

/* ===== Levels ===== */
.level{padding:0;overflow:hidden;display:flex;flex-direction:column;transition:.35s;min-height:0}
.level:hover{transform:translateY(-6px)}
.level.selected{border-color:rgba(105,227,154,.85);box-shadow:0 0 0 1px rgba(105,227,154,.5),0 24px 60px -18px rgba(105,227,154,.5),inset 0 1px 0 rgba(255,255,255,.25);background:rgba(105,227,154,.1)}
.lvimg{position:relative;height:150px;background:var(--lv) center/cover}
.lvimg::after{content:"";position:absolute;inset:0;background:linear-gradient(180deg,transparent 40%,rgba(5,20,13,.8))}
.lvbadge{position:absolute;z-index:1;left:16px;bottom:-18px;width:48px;height:48px;border-radius:16px;display:grid;place-items:center;font-size:24px;background:rgba(255,255,255,.16);-webkit-backdrop-filter:blur(14px);backdrop-filter:blur(14px);border:1px solid rgba(255,255,255,.3);box-shadow:0 10px 24px -8px rgba(0,0,0,.6)}
.lvbody{padding:30px 20px 20px;display:flex;flex-direction:column;flex:1}
.level .tag{display:inline-block;color:var(--lime);font-size:11px;letter-spacing:.14em;font-weight:800}
.level h3{font-size:22px;margin:6px 0 4px}
.level p{color:var(--muted);margin:4px 0 8px;flex:1}
.level button{margin-top:14px}

.sectionhead{display:flex;align-items:end;justify-content:space-between;gap:12px;margin:34px 0 16px}
.sectionhead h2{margin:0;font-size:24px;letter-spacing:-.02em}
.bar{height:10px;background:rgba(255,255,255,.1);border-radius:20px;overflow:hidden;box-shadow:inset 0 1px 3px rgba(0,0,0,.4)}
.bar span{display:block;height:100%;width:0;background:linear-gradient(90deg,var(--green),var(--lime));border-radius:20px;transition:width .6s;box-shadow:0 0 16px rgba(184,242,123,.7)}
.routine{display:flex;align-items:center;gap:16px;padding:14px 0;border-bottom:1px solid rgba(255,255,255,.1)}
.routine:last-child{border:0}
.routine strong{display:block;font-size:16px}
.routine .mins{margin-left:auto;color:var(--lime);white-space:nowrap;font-size:12px;font-weight:700;padding:6px 12px;border-radius:20px;background:rgba(184,242,123,.12);border:1px solid rgba(184,242,123,.25)}
.tmthumb{width:64px;height:64px;flex:none;border-radius:20px;background:var(--lv) center/cover;display:grid;place-items:center;font-size:26px;border:1px solid var(--line);box-shadow:0 10px 24px -10px rgba(0,0,0,.7)}
.check{width:23px;height:23px;accent-color:var(--green)}

/* ===== Milestones ===== */
.milestones{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px}
.mile{position:relative;overflow:hidden;min-height:260px;transition:.35s}
.mile:hover{transform:translateY(-6px)}
.medalbox{height:128px;margin:-26px -26px 16px;display:grid;place-items:center;background:var(--art-rays) center/cover;border-bottom:1px solid rgba(255,255,255,.1)}
.mile .medal{font-size:54px;filter:drop-shadow(0 8px 20px rgba(255,212,119,.55))}
.mile.locked{opacity:.7}.mile.locked .medalbox{filter:grayscale(1) brightness(.7)}.mile.locked .medal{filter:none}
.mile.unlocked{border-color:rgba(255,212,119,.6);background:linear-gradient(160deg,rgba(255,212,119,.16),rgba(255,255,255,.05));box-shadow:0 24px 60px -22px rgba(255,212,119,.45),inset 0 1px 0 rgba(255,255,255,.25)}
.mile h3{margin:6px 0}
.mile .quote{color:#f5dfae;min-height:48px}
.mile .status{font-size:11px;font-weight:800;letter-spacing:.14em;color:var(--lime)}
.mile.locked .status{color:var(--muted)}
.mile .play{border:1px solid var(--line);background:rgba(255,255,255,.08);color:var(--cream);border-radius:12px;padding:9px 14px;font-weight:600;transition:.25s}
.mile .play:hover{background:rgba(255,255,255,.16);border-color:var(--gold)}

/* ===== Profile ===== */
.profiletop{display:flex;align-items:center;gap:22px;flex-wrap:wrap}
.avatar{width:108px;height:108px;border-radius:50%;object-fit:cover;border:3px solid transparent;background:linear-gradient(#10281b,#10281b) padding-box,linear-gradient(135deg,var(--lime),var(--green),var(--gold)) border-box;box-shadow:0 0 0 6px rgba(255,255,255,.07),0 16px 40px -10px rgba(105,227,154,.6)}
.profiletop h2{font-size:30px;margin:0}
.field{display:grid;gap:7px;color:var(--muted);font-size:13px;font-weight:500}
.field input,.field select{background:rgba(255,255,255,.07);color:var(--cream);border:1px solid var(--line);padding:12px 14px;border-radius:14px;width:100%;transition:.25s;outline:0}
.field input:focus,.field select:focus{border-color:var(--green);background:rgba(255,255,255,.11);box-shadow:0 0 0 4px rgba(105,227,154,.18)}
.field input[type=file]{padding:9px}
.field input[type=file]::file-selector-button{border:0;background:rgba(105,227,154,.2);color:var(--green);padding:6px 12px;border-radius:9px;margin-right:10px;font-weight:600;cursor:pointer}
input[type=range]{accent-color:var(--green)}
.formrow{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px;margin:16px 0}
.daygrid{display:grid;grid-template-columns:repeat(10,1fr);gap:8px}
.day{aspect-ratio:1;border:1px solid var(--line);background:var(--glass);color:var(--muted);border-radius:14px;display:grid;place-items:center;font-weight:700;transition:.2s}
.day:hover{background:var(--glass2);color:var(--cream);transform:translateY(-2px)}
.day.done{background:linear-gradient(135deg,var(--lime),var(--green));color:#06210f;border-color:transparent;box-shadow:0 8px 20px -8px rgba(105,227,154,.8)}
.day.today{outline:2px solid var(--gold);outline-offset:2px;box-shadow:0 0 22px rgba(255,212,119,.45)}
.notice{padding:16px 18px;border-radius:18px;background:rgba(105,227,154,.1);border:1px solid rgba(105,227,154,.28);color:#e4ffec;margin:14px 0;-webkit-backdrop-filter:blur(10px);backdrop-filter:blur(10px)}
.timer{font-size:26px;font-weight:800;color:var(--lime);font-variant-numeric:tabular-nums}

/* ===== Modal ===== */
.overlay{position:fixed;inset:0;background:rgba(2,8,5,.62);-webkit-backdrop-filter:blur(10px);backdrop-filter:blur(10px);z-index:30;display:none;place-items:center;padding:18px}
.overlay.show{display:grid}
.modal{width:min(520px,100%);text-align:center;padding:36px 28px;background:linear-gradient(160deg,rgba(255,212,119,.2),rgba(255,255,255,.07)),var(--art-rays) center top/cover;-webkit-backdrop-filter:var(--blur);backdrop-filter:var(--blur);border:1px solid rgba(255,212,119,.6);border-radius:30px;box-shadow:0 40px 100px -20px rgba(255,212,119,.4),inset 0 1px 0 rgba(255,255,255,.3);position:relative;overflow:hidden;animation:pop .55s cubic-bezier(.2,1.5,.4,1)}
.modal .bigmedal{font-size:80px;animation:medal .9s ease-in-out infinite alternate}
.modal h2{font-size:32px;margin:8px}
.modal p{color:#f5dfae}
.confetti{position:fixed;top:-20px;width:9px;height:15px;z-index:65;pointer-events:none;animation:fall 2.8s linear forwards}
@keyframes pop{from{transform:scale(.55) rotate(-5deg);opacity:0}to{transform:scale(1);opacity:1}}
@keyframes medal{to{transform:translateY(-8px) rotate(8deg);filter:drop-shadow(0 0 22px #ffd477)}}
@keyframes fall{to{transform:translate(var(--drift),110vh) rotate(720deg);opacity:0}}
.footer{text-align:center;color:var(--muted);padding:34px 0;font-size:12px;letter-spacing:.12em}

/* ===== Auth ===== */
.auth,.player{position:fixed;inset:0;z-index:40;display:none;overflow:auto;padding:18px;background:linear-gradient(rgba(3,11,7,.55),rgba(3,11,7,.8)),var(--art-hero) center/cover}
.auth.show{display:flex}.player.show{display:block}
.authbox{width:min(920px,100%);margin:auto;padding:0;overflow:hidden;display:grid;grid-template-columns:1.05fr 1fr}
.authart{position:relative;padding:34px;display:flex;flex-direction:column;justify-content:space-between;min-height:520px;background:linear-gradient(180deg,rgba(4,16,10,.55),rgba(4,16,10,.1) 45%,rgba(4,16,10,.85)),var(--art-hero) 62% center/cover;border-right:1px solid var(--line)}
.authart h2{font-size:clamp(28px,3.4vw,40px);line-height:1.08;letter-spacing:-.03em;margin:0 0 10px}
.authart h2 span{color:var(--green)}
.authform{padding:34px;display:flex;flex-direction:column;justify-content:center}
.pl{width:min(780px,100%);margin:0 auto}
.tabs{display:flex;gap:6px;margin:14px 0;padding:4px;border-radius:16px;background:rgba(255,255,255,.06)}
.tabs button{flex:1;border:0;background:transparent}
.tabs .ghost.active{background:linear-gradient(135deg,var(--lime),var(--green));color:#06210f;font-weight:700}
.err{color:var(--red);min-height:20px;font-size:13px;margin-bottom:6px}

/* ===== Workout player ===== */
.ring{position:relative;width:min(260px,64vw);aspect-ratio:1;margin:14px auto;filter:drop-shadow(0 0 26px rgba(105,227,154,.35))}
.ring svg{width:100%;height:100%;transform:rotate(-90deg)}
.ring circle{fill:none;stroke-width:8}
.ring .bg{stroke:rgba(255,255,255,.12)}
.ring .fg{stroke:var(--green);stroke-linecap:round;transition:stroke-dashoffset 1s linear}
.ring .t{position:absolute;inset:0;display:grid;place-content:center;text-align:center}
.ring .t b{font-size:58px;line-height:1;font-variant-numeric:tabular-nums;font-family:var(--head)}
.ex{border:1px solid var(--line);background:var(--glass);-webkit-backdrop-filter:blur(14px);backdrop-filter:blur(14px);border-radius:22px;margin:12px 0;text-align:left;overflow:hidden;box-shadow:0 14px 34px -16px rgba(0,0,0,.6)}
.exhead{display:flex;align-items:center;gap:12px;padding:14px 18px;background:linear-gradient(120deg,var(--c1,#14543a),var(--c2,#0a2a1c));border-bottom:1px solid rgba(255,255,255,.1);position:relative;overflow:hidden}
.exhead::after{content:"";position:absolute;right:-30px;top:-40px;width:140px;height:140px;border-radius:50%;background:rgba(255,255,255,.1)}
.exicon{width:42px;height:42px;border-radius:14px;background:rgba(255,255,255,.18);display:grid;place-items:center;font-size:21px;border:1px solid rgba(255,255,255,.25);position:relative;z-index:1}
.exhead h4{margin:0;font-size:17px;position:relative;z-index:1}
.exbody{padding:14px 18px 16px}
.p-Lower{--c1:#1c7a4f;--c2:#0b3322}.p-Upper{--c1:#2b6aa8;--c2:#0e2a44}.p-Core{--c1:#a8742b;--c2:#3b2a0c}.p-Cardio{--c1:#a83a4a;--c2:#3b0f17}.p-Mobility{--c1:#3d8f8a;--c2:#0d3330}
.chip{display:inline-block;font-size:11px;font-weight:700;padding:4px 10px;border-radius:20px;background:rgba(184,242,123,.12);border:1px solid rgba(184,242,123,.25);color:var(--lime);margin:0 5px 4px 0}
.ex ol{margin:10px 0;padding-left:20px;color:#dbe8df}
.ex li{margin:3px 0}
.tip{color:var(--gold);font-size:13px}
.ctl{display:flex;gap:10px;justify-content:center;flex-wrap:wrap;margin:14px 0}
.ctl .btn{padding:15px 34px;font-size:17px}
#unlockModal{z-index:60}

@media(max-width:760px){.top{align-items:flex-start;flex-direction:column;top:8px}.nav{width:100%;overflow:auto;flex-wrap:nowrap}.nav button{white-space:nowrap}.g3,.milestones{grid-template-columns:repeat(2,minmax(0,1fr))}.stats{grid-template-columns:repeat(2,minmax(0,1fr))}.wrap{margin-top:20px}.hero{padding:28px 22px;min-height:230px}.hero-lg{min-height:400px}.authbox{grid-template-columns:1fr}.authart{display:none}}
@media(max-width:480px){.g2,.g3,.milestones{grid-template-columns:1fr}.formrow{grid-template-columns:1fr}.panel{padding:19px}.medalbox{margin:-19px -19px 16px}.daygrid{grid-template-columns:repeat(6,1fr)}.hero-lg{min-height:380px}}
@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}
</style>
<script>(function(){
const U=s=>'url("data:image/svg+xml;utf8,'+encodeURIComponent(s)+'")';
const svg=(b,w=1200,h=600)=>`<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 ${w} ${h}" preserveAspectRatio="xMidYMid slice">${b}</svg>`;
let seed=11;const rnd=()=>(seed=(seed*9301+49297)%233280)/233280;
const stars=(n,h)=>{let s='';for(let i=0;i<n;i++){const a=rnd(),b=rnd();s+=`<circle cx="${(a*1200)|0}" cy="${(b*h)|0}" r="${(.6+rnd()*1.3).toFixed(1)}" fill="#fff" opacity="${(.2+rnd()*.5).toFixed(2)}"/>`}return s};
const man=(x,y,s,c,pose)=>{const L=pose==='run'?`<circle cx="8" cy="-64" r="9" fill="${c}" stroke="none"/><path d="M2-50L-6-20M2-46L18-36L28-48M0-46L-14-34L-26-42M-6-20L10-6L2 12M-6-20L-20-4L-34-10"/>`:`<circle cx="0" cy="-66" r="9" fill="${c}" stroke="none"/><path d="M0-52V-18M0-48L-20-72M0-48L20-72M0-18L-13 12M0-18L13 12"/>`;return `<g transform="translate(${x} ${y}) scale(${s})" stroke="${c}" stroke-width="6" stroke-linecap="round" stroke-linejoin="round" fill="none">${L}</g>`};
